NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Worker secrets: configure with wrangler secret put (not public build variables).
# TURNSTILE_SECRET_KEY
# RESEND_API_KEY
# FORM_FROM_EMAIL (e.g. Beckett House Montessori <hello@beckett-house.co.uk>)
# GOOGLE_SERVICE_ACCOUNT_EMAIL
# GOOGLE_PRIVATE_KEY (PKCS8 PEM; literal \n sequences are supported)
# SHEET_VISIT_ANGEL
# SHEET_VISIT_ABBEY_ROAD
# SHEET_REGISTER_ANGEL
# SHEET_REGISTER_ABBEY_ROAD
